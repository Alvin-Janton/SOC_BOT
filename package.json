{
  "name": "soc-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "infra",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace @soc-bot/infra",
    "lint": "eslint infra/bin infra/lib infra/lambdas infra/test frontend/src frontend/vite.config.ts frontend/scripts --ext .ts,.tsx,.mjs",
    "frontend:dev": "npm run dev --workspace @soc-bot/frontend",
    "frontend:build": "npm run build --workspace @soc-bot/frontend",
    "playbooks:validate": "npm run build && node infra/dist/bin/validate-playbook-index.js",
    "test": "npm run test --workspace @soc-bot/infra",
    "synth": "npm run build && npm run synth --workspace @soc-bot/infra",
    "infra:build": "npm run build --workspace @soc-bot/infra",
    "infra:test": "npm run test --workspace @soc-bot/infra",
    "infra:synth": "npm run build && npm run synth --workspace @soc-bot/infra"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.70.1"
  }
}
