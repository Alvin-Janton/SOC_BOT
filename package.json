{
  "name": "soc-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspace @soc-bot/infra",
    "test": "npm run test --workspace @soc-bot/infra",
    "synth": "npm run build && npm run synth --workspace @soc-bot/infra",
    "infra:build": "npm run build --workspace @soc-bot/infra",
    "infra:test": "npm run test --workspace @soc-bot/infra",
    "infra:synth": "npm run build && npm run synth --workspace @soc-bot/infra"
  }
}
